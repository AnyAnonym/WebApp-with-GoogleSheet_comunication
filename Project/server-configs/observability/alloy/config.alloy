logging {
  level = "info"
}

loki.relabel "epiber_journal" {
  forward_to = []

  rule {
    source_labels = ["__journal__systemd_unit"]
    target_label  = "unit"
  }
}

loki.source.journal "paj" {
  forward_to    = [loki.process.epiber.receiver]
  relabel_rules = loki.relabel.epiber_journal.rules
  matches       = "_SYSTEMD_UNIT=epiber-paj.service"
  max_age       = "24h"
  labels = {
    deployment = "paj",
    service    = "epiber-backend",
  }
}

loki.source.journal "pk" {
  forward_to    = [loki.process.epiber.receiver]
  relabel_rules = loki.relabel.epiber_journal.rules
  matches       = "_SYSTEMD_UNIT=epiber-pk.service"
  max_age       = "24h"
  labels = {
    deployment = "pk",
    service    = "epiber-backend",
  }
}

loki.source.journal "live" {
  forward_to    = [loki.process.epiber.receiver]
  relabel_rules = loki.relabel.epiber_journal.rules
  matches       = "_SYSTEMD_UNIT=epiber-piber.service"
  max_age       = "24h"
  labels = {
    deployment = "live",
    service    = "epiber-backend",
  }
}

loki.source.journal "grafana_auth" {
  forward_to    = [loki.process.epiber.receiver]
  relabel_rules = loki.relabel.epiber_journal.rules
  matches       = "_SYSTEMD_UNIT=epiber-grafana-auth.service"
  max_age       = "24h"
  labels = {
    deployment = "shared",
    service    = "grafana-auth",
  }
}

local.file_match "epiber_caddy" {
  path_targets = [
    {
      __path__   = "/var/log/caddy/epiber-live-access.json",
      deployment = "live",
      service    = "caddy-access",
    },
    {
      __path__   = "/var/log/caddy/epiber-paj-access.json",
      deployment = "paj",
      service    = "caddy-access",
    },
    {
      __path__   = "/var/log/caddy/epiber-pk-access.json",
      deployment = "pk",
      service    = "caddy-access",
    },
  ]
}

loki.source.file "epiber_caddy" {
  targets    = local.file_match.epiber_caddy.targets
  forward_to = [loki.process.epiber_caddy.receiver]
}

loki.process "epiber" {
  forward_to = [loki.write.local.receiver]

  stage.json {
    expressions = {
      event           = "event",
      app_level       = "level",
      page_type       = "pageType",
      app_version     = "version",
      version_match   = "clientVersionMatch",
      diagnostic      = "diagnosticProfile",
      retention_class = "retentionClass",
      frontend_event  = "frontendEvent",
      frontend_level  = "frontendLevel",
    }
  }

  stage.labels {
    values = {
      event           = "",
      app_level       = "",
      page_type       = "",
      app_version     = "",
      version_match   = "",
      diagnostic      = "",
      retention_class = "",
      frontend_event  = "",
      frontend_level  = "",
    }
  }
}

loki.process "epiber_caddy" {
  forward_to = [loki.write.local.receiver]

  stage.json {
    expressions = {
      request_route = "route",
      status        = "status",
    }
  }

  stage.labels {
    values = {
      request_route = "",
      status        = "",
    }
  }
}

loki.write "local" {
  endpoint {
    url = "http://127.0.0.1:3100/loki/api/v1/push"
  }
}
