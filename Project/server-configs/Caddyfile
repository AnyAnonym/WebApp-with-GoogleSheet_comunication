# ePiber reverse proxy and static frontend
# All browser-facing systems use HTTPS/WSS.

(security_headers) {
	header {
		-Server
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin"
	}
}

epiber.at {
	import security_headers
	header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self' https://epiber.at wss://epiber.at; frame-src 'self'; frame-ancestors 'self'; object-src 'none'; base-uri 'self'; form-action 'self'"

	@backend path /ws /api/* /live /ready /health /version /status
	handle @backend {
		reverse_proxy 127.0.0.1:8080
	}

	handle {
		root * /srv/http/ePiber/piber/Frontend
		header Cache-Control "no-cache"
		file_server
	}
}

https://epiber.at:8081 {
	import security_headers
	@paj_application not path /grafana/*
	header @paj_application Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self' https://epiber.at:8081 wss://epiber.at:8081; frame-src 'self'; frame-ancestors 'self'; object-src 'none'; base-uri 'self'; form-action 'self'"
	@grafana_content path /grafana/*
	header @grafana_content Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-eval' 'unsafe-inline'; style-src 'self' 'unsafe-inline' blob:; font-src 'self' data:; img-src 'self' data: blob:; connect-src 'self' wss://epiber.at:8081; frame-src 'self'; frame-ancestors 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; manifest-src 'self'; worker-src 'self' blob:"
	log paj_access {
		output file /var/log/caddy/epiber-paj-access.json {
			mode 0640
			roll_size 20MiB
			roll_at 00:00
			roll_keep 14
			roll_keep_for 336h
		}
		format filter {
			request>uri regexp `\?.*$` ""
			request>headers delete
			request>remote_ip delete
			request>remote_port delete
			request>client_ip delete
			resp_headers delete
			wrap json
		}
	}

	@backend path /ws /api/* /live /ready /health /version /status
	handle @backend {
		reverse_proxy 127.0.0.1:8083
		log_append request_id {rp.header.X-Request-ID}
		log_append route backend
	}

	redir /grafana /grafana/ 308
	handle /grafana/* {
		forward_auth 127.0.0.1:8083 {
			uri /api/admin/grafana-auth
			copy_headers X-WEBAUTH-USER X-WEBAUTH-ROLE
		}
		reverse_proxy 127.0.0.1:3000
		log_append route grafana
	}

	handle {
		log_append route static
		root * /srv/http/ePiber/paj/Frontend
		header Cache-Control "no-cache"
		file_server
	}
}

https://epiber.at:8082 {
	import security_headers
	header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self' https://epiber.at:8082 wss://epiber.at:8082; frame-src 'self'; frame-ancestors 'self'; object-src 'none'; base-uri 'self'; form-action 'self'"

	@backend path /ws /api/* /live /ready /health /version /status
	handle @backend {
		reverse_proxy 127.0.0.1:8084
	}

	handle {
		root * /srv/http/ePiber/pk/Frontend
		header Cache-Control "no-cache"
		file_server
	}
}
