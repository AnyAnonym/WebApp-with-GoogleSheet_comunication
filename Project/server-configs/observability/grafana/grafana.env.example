# Copy to /etc/epiber-observability/grafana.env with mode 0600 and replace all values.
GF_SECURITY_ADMIN_PASSWORD=replace-with-a-long-random-password
GF_SECURITY_SECRET_KEY=replace-with-at-least-32-random-characters
EPIBER_ALERT_EMAIL=operator@example.invalid
GF_SMTP_ENABLED=true
GF_SMTP_HOST=mail.example.invalid:587
GF_SMTP_USER=replace-with-smtp-user
GF_SMTP_PASSWORD=replace-with-smtp-password
GF_SMTP_FROM_ADDRESS=epiber-alerts@example.invalid
