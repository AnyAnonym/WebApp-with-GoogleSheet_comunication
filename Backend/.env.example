# ══════════════════════════════════════════════════════
# Backend-Umgebungskonfiguration
# Diese geheimnisfreie Vorlage wird versioniert.
# Kopiere sie als .env und ersetze alle CHANGE_ME-Werte.
# ══════════════════════════════════════════════════════

# Google Spreadsheet ID (pro System unterschiedlich)
SHEET_ID=CHANGE_ME

# Node.js-Server-Port (pro System unterschiedlich)
# Live (piber): 8080
# PAJ:          8083
# PK:           8084
PORT=CHANGE_ME

# Instanz, Origin, Loopback-Bindung, Transportpolicy, State-Pfad und
# GOOGLE_APPLICATION_CREDENTIALS setzt die jeweilige systemd-Unit verbindlich.

# Session-Laufzeit in Sekunden
SESSION_TTL_SECONDS=28800
PASSWORD_RESET_TTL_SECONDS=900

# Court-Scores-URL (normalerweise fuer alle Systeme gleich)
COURT_URL=https://scorer-tennis.b-cdn.net/json/24.voll.json

# Die systemd-Unit bindet Backend/service-account.json als geschuetztes Credential ein.

# Kommunikationsgrenzen und Timeouts (optionale sichere Defaults)
HTTP_BODY_LIMIT_BYTES=8192
HTTP_REQUEST_TIMEOUT_MS=30000
HTTP_HEADERS_TIMEOUT_MS=10000
HTTP_KEEP_ALIVE_TIMEOUT_MS=5000
WS_MAX_PAYLOAD_BYTES=16384
WS_MAX_INFLIGHT=8
WS_MAX_SUBSCRIPTIONS=32
WS_REQUEST_RATE=20
WS_REQUEST_BURST=40
COURT_FETCH_TIMEOUT_MS=5000
GOOGLE_REQUEST_TIMEOUT_MS=10000
SHUTDOWN_GRACE_MS=90000
