    "node": ">=26 <27"
  },
  "packageManager": "npm@12.0.1",
  "dependencies": {
    "googleapis": "^171.4.0",
    "ws": "^8.18.0"
  },
  "overrides": {
    "gaxios": "7.3.0"
  }
}
