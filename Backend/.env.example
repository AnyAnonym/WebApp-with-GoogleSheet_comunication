# ══════════════════════════════════════════════════════
# Backend-Umgebungskonfiguration
# Diese geheimnisfreie Vorlage wird versioniert.
# Kopiere sie als .env und ersetze alle CHANGE_ME-Werte.
# ══════════════════════════════════════════════════════

# Google Spreadsheet ID (pro System unterschiedlich)
# Live (piber): 1E1CYezDcScIBvH9ebjN0hOkvttTdA6PFIgYKDMaeE04
# PAJ:          1auOvEer7i1PW7LO4QX73188Q81Q6QguGyt0zadIIaqo
# PK:           <noch offen>
SHEET_ID=CHANGE_ME

# Node.js-Server-Port (pro System unterschiedlich)
# Live (piber): 8080
# PAJ:          8083
# PK:           8084
PORT=CHANGE_ME

# Instanz, Origin, Loopback-Bindung, Pfade fuer State-, ScoreLog-, Audit- und Messaging-SQLite sowie
# GOOGLE_APPLICATION_CREDENTIALS setzt die jeweilige systemd-Unit verbindlich.
# Unsicherer Transport bleibt ohne ausdrueckliche Unit-Ausnahme deaktiviert.

# Session-Laufzeit in Sekunden
SESSION_TTL_SECONDS=28800
PASSWORD_RESET_TTL_SECONDS=900

# Court-Scores-URL (normalerweise fuer alle Systeme gleich)
COURT_URL=https://scorer-tennis.b-cdn.net/json/24.voll.json

# Die systemd-Unit bindet die systemspezifische Quelldatei als geschuetztes Credential ein.
# Live (piber): /srv/http/ePiber/piber/Backend/epiberpiber-31aebe556ced.json
# PAJ:          /srv/http/ePiber/paj/Backend/epiberpaj-5032a34639bf.json
# PK:           /srv/http/ePiber/pk/Backend/service-account.json

# Kommunikationsgrenzen und Timeouts (optionale sichere Defaults)
LOG_LEVEL=info
SCORE_LOG_JOURNAL=true
AUDIT_LOG_JOURNAL=true
# Optionaler Pfad, Standard: messaging.sqlite im Verzeichnis von STATE_FILE
# MESSAGING_FILE=/var/lib/epiber-<system>/messaging.sqlite
# Kommagetrennte Auditaktionen oder * fuer alle konfigurierten Mutationen
AUDIT_ACTIONS=*
HTTP_BODY_LIMIT_BYTES=8192
HTTP_REQUEST_TIMEOUT_MS=30000
HTTP_HEADERS_TIMEOUT_MS=10000
HTTP_KEEP_ALIVE_TIMEOUT_MS=5000
WS_MAX_PAYLOAD_BYTES=16384
WS_MAX_INFLIGHT=8
WS_MAX_SUBSCRIPTIONS=32
WS_REQUEST_RATE=20
WS_REQUEST_BURST=40
WS_HANDSHAKE_TIMEOUT_MS=10000
COURT_FETCH_TIMEOUT_MS=5000
GOOGLE_REQUEST_TIMEOUT_MS=10000
SHEET_STARTUP_RETRY_BASE_MS=5000
SHEET_STARTUP_RETRY_MAX_MS=60000
SHUTDOWN_GRACE_MS=90000
