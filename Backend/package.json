{
  "name": "epiber-backend",
  "version": "4.6.1-paj-1-4",
  "description": "ePiber Tennis Dashboard — Backend (WebSocket + Google Sheets)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "check": "node scripts/check.js",
    "test": "node --test test/*.test.js",
    "test:browser": "node --test test/*.browser.js",
    "test:workflow": "node --test ../scripts/*.test.mjs",
    "test:coverage": "node --test --experimental-test-coverage",
    "build": "npm run check && npm test && npm run test:workflow"
  },
  "engines": {
    "node": ">=26 <27"
  },
  "packageManager": "npm@12.0.2",
  "dependencies": {
    "googleapis": "^171.4.0",
    "ws": "^8.18.0"
  },
  "overrides": {
    "gaxios": "7.3.0"
  },
  "devDependencies": {
    "playwright-core": "1.62.1"
  }
}
