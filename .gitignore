# ══════════════════════════════════════════════════════
# .gitignore — ePiber Projekt (Self-Hosted)
# ══════════════════════════════════════════════════════

# ── Umgebungsspezifische Konfigdateien (NICHT einchecken!) ──
Backend/.env
Backend/.env.bak
Backend/service-account.json

# ── Node.js ──
node_modules/
npm-debug.log*

# Lokaler Entwicklungs-State; Produktiv-State liegt unter /var/lib
Backend/.state/

# ── Logs ──
logs/
*.log

# ── OS-Dateien ──
.DS_Store
Thumbs.db
desktop.ini

# ── IDE ──
.vs/
.vscode/
.idea/

# ── Alte Firebase-Dateien (Legacy, nicht mehr benötigt) ──
.firebase/
.firebaserc

# ── Sonstiges ──
*.tgz
.env
.eslintcache

# ── Lokales temporaeres Main-Changelog ──
Project/ChangeLogs/ChangeLog-main.tmp

