{
  "name": "epiber-backend",
  "version": "4.2.0-paj-1-5",
  "description": "ePiber Tennis Dashboard — Backend (WebSocket + Google Sheets)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
